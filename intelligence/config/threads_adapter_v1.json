{
  "version": "threads-browser-v1",
  "_comment": "Threads public posts in a visible, manually logged-in browser (search needs a login; threads.net redirects to threads.com — both allowed). Ships DISABLED. Threads uses almost no stable test ids; the structure-based selectors below are best guesses, not validated live in this repo. Canonical URLs use the handle-free /t/<code> form; navigation uses the URL found in search (transient).",
  "hosts": ["threads.com", "threads.net", "cdninstagram.com", "fbcdn.net"],
  "login": {"url": "https://www.threads.com/login", "cookie_url": "https://www.threads.com", "cookies": ["sessionid"]},
  "search": {"keyword_url": "https://www.threads.com/search?q={query}&serp_type=default", "use_keyword_search": true},
  "post_url": {
    "hosts": ["threads.com", "threads.net"],
    "path_patterns": ["^/@[A-Za-z0-9._]{1,30}/post/(?P<id>[A-Za-z0-9_-]{5,40})/?", "^/t/(?P<id>[A-Za-z0-9_-]{5,40})/?"],
    "canonical": "https://www.threads.com/t/{id}"
  },
  "handle_regex": "^/@([A-Za-z0-9._]{1,30})/?$",
  "reserved_paths": [],
  "profile_url": "https://www.threads.com/@{handle}",
  "comment_id_regex": "/post/([A-Za-z0-9_-]{5,40})",
  "comment_url": "https://www.threads.com/t/{id}",
  "visibility_evidence": "public Threads post page rendered (profile not private, post available)",
  "selectors": {
    "search_result_link": ["div[data-pressable-container='true'] a[href*='/post/']:has(time)", "a[href*='/post/']"],
    "post_region": ["div[data-pressable-container='true']"],
    "post_text": ["div > span[dir='auto']:not(a *)", "span[dir='auto']:not(a *)"],
    "post_text_strip": [],
    "post_time": ["time[datetime]"],
    "post_author_link": ["a[href^='/@']:not([href*='/post/'])"],
    "post_author_name": ["a[href^='/@']:not([href*='/post/']) span"],
    "like_count": ["[aria-label^='Like'] + span", "svg[aria-label='Like'] ~ span"],
    "comment_count": [],
    "org_marker": ["[aria-label*='business' i]"],
    "comment_list": [],
    "comment_item": ["div[data-pressable-container='true']"],
    "comment_text": ["div > span[dir='auto']:not(a *)", "span[dir='auto']:not(a *)"],
    "comment_text_strip": [],
    "comment_author_link": ["a[href^='/@']:not([href*='/post/'])"],
    "comment_author_name": ["a[href^='/@']:not([href*='/post/']) span"],
    "comment_time": ["time[datetime]"],
    "comment_permalink": ["a[href*='/post/']:has(time)"],
    "reply_marker": [],
    "expand_button": ["div[role='button']", "button", "span[role='button']"],
    "comments_button": [],
    "comments_disabled": [],
    "challenge": ["iframe[src*='captcha']", "form[action*='/challenge/']"]
  },
  "hide_selectors": ["a[href^='/@']:not([href*='/post/'])", "img[alt*='profile picture' i]", "[data-pressable-container='true'] img"],
  "text_markers": {
    "expand": "^((view|see|show) (all |more )?(\\d+ )?(more )?repl(y|ies))",
    "login_prompt": ["log in with your instagram", "log in or sign up for threads", "log in to see more", "continue with instagram"],
    "login_url": ["/login"],
    "private": ["this profile is private", "this account is private"],
    "unavailable": ["sorry, this page isn't available", "sorry, this page isn’t available", "post unavailable", "this post is unavailable"],
    "challenge": ["help us confirm it's you", "help us confirm it’s you", "suspicious login attempt"],
    "challenge_url": ["/challenge/", "/checkpoint/"]
  },
  "skip_reasons": {"private": "private_account", "unavailable": "post_unavailable"},
  "limits": {
    "max_results_per_query": 10,
    "max_search_scrolls": 4,
    "max_comments_per_post": 200,
    "max_replies_per_comment": 50,
    "max_expansion_rounds": 15,
    "no_new_comment_attempts": 3,
    "comment_time_limit_s": 120,
    "scroll_pause_ms": 1800,
    "click_pause_ms": 700,
    "settle_ms": 4000
  }
}
