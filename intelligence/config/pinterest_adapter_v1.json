{
  "version": "pinterest-browser-v1",
  "_comment": "Pinterest public pins in a visible browser (manual login optional but Pinterest often shows a sign-up wall). Ships DISABLED. data-test-id selectors are best guesses from Pinterest's public markup, not validated live in this repo. Most pins have no comments → completeness comments_unavailable.",
  "hosts": ["pinterest.com", "pinterest.co.uk", "pinterest.ca", "pinterest.com.au", "pinterest.fr", "pinterest.de", "pinterest.jp", "pinimg.com"],
  "login": {"url": "https://www.pinterest.com/login/", "cookie_url": "https://www.pinterest.com", "cookies": [{"name": "_auth", "value": "1"}]},
  "search": {"keyword_url": "https://www.pinterest.com/search/pins/?q={query}&rs=typed", "use_keyword_search": true},
  "post_url": {
    "hosts": ["pinterest.com", "pinterest.co.uk", "pinterest.ca", "pinterest.com.au", "pinterest.fr", "pinterest.de", "pinterest.jp"],
    "path_patterns": ["^/pin/(?:[A-Za-z0-9-]*--)?(?P<id>\\d{6,25})/?"],
    "canonical": "https://www.pinterest.com/pin/{id}/"
  },
  "handle_regex": "^/([A-Za-z0-9_]{3,30})/?$",
  "reserved_paths": ["pin", "search", "ideas", "today", "business", "login", "settings", "about", "_"],
  "profile_url": "https://www.pinterest.com/{handle}/",
  "comment_id_regex": null,
  "comment_url": null,
  "visibility_evidence": "public Pinterest pin page rendered",
  "selectors": {
    "search_result_link": ["[data-test-id='pin'] a[href*='/pin/']", "[data-grid-item] a[href*='/pin/']", "a[href*='/pin/']"],
    "post_region": ["[data-test-id='closeup-body']", "[data-test-id='pin-closeup']", "div[data-test-id*='closeup']"],
    "post_title": ["[data-test-id='pin-title']", "[data-test-id='closeup-title'] h1", "h1"],
    "post_text": ["[data-test-id='pin-description']", "[data-test-id='truncated-description']", "[data-test-id='closeup-description']"],
    "post_text_strip": [],
    "post_time": ["time[datetime]"],
    "post_author_link": ["[data-test-id='creator-profile'] a[href^='/']", "[data-test-id='official-user-attribution'] a[href^='/']", "[data-test-id='creator-avatar-link']"],
    "post_author_name": ["[data-test-id='creator-profile-name']", "[data-test-id='creator-profile'] a span"],
    "like_count": ["[data-test-id='reactions-count']"],
    "comment_count": ["[data-test-id='comments-count']"],
    "org_marker": ["[data-test-id='verified-merchant-badge']", "[data-test-id='business-badge']"],
    "comment_list": ["[data-test-id='comments-list']", "[data-test-id='canonical-comments']"],
    "comment_item": ["[data-test-id='comment']", "[data-test-id='canonical-comment']"],
    "comment_text": ["[data-test-id='comment-text']", "[data-test-id='text-container']"],
    "comment_text_strip": [],
    "comment_author_link": ["a[href^='/']"],
    "comment_author_name": ["[data-test-id='comment-author']"],
    "comment_time": ["time[datetime]", "[data-test-id='comment-time']"],
    "comment_permalink": [],
    "reply_marker": [],
    "expand_button": ["button", "div[role='button']"],
    "comments_button": ["[data-test-id='comments-tab']", "button[aria-label*='comments' i]"],
    "comments_disabled": ["[data-test-id='comments-disabled']"],
    "challenge": ["iframe[src*='captcha']", "iframe[src*='recaptcha']"]
  },
  "hide_selectors": ["[data-test-id='creator-profile']", "[data-test-id*='avatar']", "[data-test-id='comment-author']", "[data-test-id='comment'] a[href^='/']"],
  "text_markers": {
    "expand": "^((see|view|show) (more|all) (comments|replies)|(view|see) \\d+ (more )?repl(y|ies))",
    "login_prompt": ["log in to see more", "sign up to see more", "log in to pinterest", "welcome to pinterest"],
    "login_url": ["/login"],
    "private": ["this pin is private", "this board is secret", "this account is private"],
    "unavailable": ["sorry, we couldn't find that page", "sorry, we couldn’t find that pin", "this pin was deleted", "page not found"],
    "challenge": ["verify you're human", "verify you’re human", "unusual activity from your"],
    "challenge_url": ["/challenge/"]
  },
  "skip_reasons": {"private": "private_pin", "unavailable": "pin_unavailable"},
  "limits": {
    "max_results_per_query": 10,
    "max_search_scrolls": 3,
    "max_comments_per_post": 100,
    "max_replies_per_comment": 30,
    "max_expansion_rounds": 8,
    "no_new_comment_attempts": 2,
    "comment_time_limit_s": 60,
    "scroll_pause_ms": 1800,
    "click_pause_ms": 700,
    "settle_ms": 4000
  }
}
