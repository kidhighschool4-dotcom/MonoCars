{
  "version": "instagram-browser-v1",
  "_comment": "Instagram public posts/reels in a visible, manually logged-in browser. Ships DISABLED (platforms_v1.json). Every DOM-specific value lives here; each selector field lists strategies tried in order. Selectors were written against the local fixture and Instagram's publicly documented structure; they have NOT been validated against the live site in this repo (no real network in tests) — check them with a headed preview run before enabling.",
  "hosts": ["instagram.com", "cdninstagram.com", "fbcdn.net"],
  "login": {"url": "https://www.instagram.com/accounts/login/", "cookie_url": "https://www.instagram.com", "cookies": ["sessionid"]},
  "search": {
    "hashtag_url": "https://www.instagram.com/explore/tags/{tag}/",
    "hashtag_valid_regex": "[A-Za-z0-9_]+",
    "keyword_url": "https://www.instagram.com/explore/search/keyword/?q={query}",
    "use_keyword_search": true
  },
  "post_url": {
    "hosts": ["instagram.com"],
    "path_patterns": ["^/(?:[A-Za-z0-9._]{1,30}/)?(?P<kind>p|reel|reels|tv)/(?P<id>[A-Za-z0-9_-]{5,40})/?"],
    "canonical": {"post": "https://www.instagram.com/p/{id}/", "p": "https://www.instagram.com/p/{id}/", "tv": "https://www.instagram.com/p/{id}/",
                  "reel": "https://www.instagram.com/reel/{id}/", "reels": "https://www.instagram.com/reel/{id}/"}
  },
  "content_types": {"reel": "instagram_reel", "reels": "instagram_reel"},
  "handle_regex": "^/([A-Za-z0-9._]{1,30})/?$",
  "reserved_paths": ["p", "reel", "reels", "tv", "explore", "accounts", "stories", "direct", "about", "legal", "developer"],
  "profile_url": "https://www.instagram.com/{handle}/",
  "comment_id_regex": "/c/(\\d+)",
  "comment_url": "https://www.instagram.com/p/{post_id}/c/{id}/",
  "visibility_evidence": "public Instagram post page rendered (not private, not unavailable)",
  "selectors": {
    "search_result_link": ["main a[href*='/p/']", "main a[href*='/reel/']", "a[href*='/p/']", "a[href*='/reel/']"],
    "post_region": ["main article", "article[role='presentation']", "div[role='dialog'] article", "main"],
    "post_text": ["main article h1", "article h1", "main h1"],
    "post_text_strip": [],
    "post_time": ["article time[datetime]", "main time[datetime]", "time[datetime]"],
    "post_author_link": ["article header a[href^='/']", "header a[href^='/']"],
    "post_author_name": ["article header a[href^='/'] span", "header a span"],
    "like_count": ["section a[href*='/liked_by/'] span", "a[href*='/liked_by/'] span", "section span[class*='like'] span"],
    "comment_count": [],
    "org_marker": ["header [aria-label*='business' i]", "header a[href*='/business/']"],
    "comment_list": ["article ul[class*='comment']", "main article ul", "article ul"],
    "comment_item": ["main article ul li", "article ul li", "div[role='dialog'] ul li"],
    "comment_text": ["div > span[dir='auto']:not(a *)", "span[dir='auto']:not(a *)"],
    "comment_text_strip": ["h3", "h2"],
    "comment_author_link": ["a[href^='/']:not([href*='/p/']):not([href*='/reel/']):not([href*='/explore/'])"],
    "comment_author_name": ["h3", "a[href^='/'] span"],
    "comment_time": ["time[datetime]"],
    "comment_permalink": ["a[href*='/c/']"],
    "reply_marker": [],
    "expand_button": ["button", "div[role='button']", "span[role='button']"],
    "comments_button": [],
    "comments_disabled": ["[data-comments-disabled]"],
    "challenge": ["iframe[src*='captcha']", "iframe[src*='recaptcha']", "form[action*='/challenge/']"]
  },
  "hide_selectors": ["header a[href^='/']", "header span", "article ul li h3", "article ul li h2", "article ul li a[href^='/']:not([href*='/p/']):not([href*='/c/'])",
                     "img[alt*='profile picture' i]", "canvas"],
  "text_markers": {
    "expand": "^(view (all )?(\\d+ )?(more )?repl(y|ies)|view replies|load more comments|view (all|more) comments|view all \\d+ comments)",
    "login_prompt": ["log in to instagram", "log into instagram", "sign up to see photos", "log in to see photos", "log in to continue"],
    "login_url": ["/accounts/login"],
    "private": ["this account is private", "follow this account to see their photos"],
    "unavailable": ["sorry, this page isn't available", "sorry, this page isn’t available", "the link you followed may be broken", "this post is unavailable"],
    "challenge": ["help us confirm it's you", "help us confirm it’s you", "suspicious login attempt", "we detected an unusual login", "enter the code we sent"],
    "challenge_url": ["/challenge/", "/checkpoint/"]
  },
  "skip_reasons": {"private": "private_account", "unavailable": "post_unavailable"},
  "limits": {
    "max_results_per_query": 10,
    "max_search_scrolls": 4,
    "max_comments_per_post": 200,
    "max_replies_per_comment": 50,
    "max_expansion_rounds": 20,
    "no_new_comment_attempts": 3,
    "comment_time_limit_s": 120,
    "scroll_pause_ms": 1800,
    "click_pause_ms": 700,
    "settle_ms": 4000
  }
}
