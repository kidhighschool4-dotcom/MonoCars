{
  "version": "x-browser-v1",
  "_comment": "X (Twitter) public posts in a visible, manually logged-in browser (search needs a login). Ships DISABLED. data-testid selectors are X's long-standing test ids; the nested-reply marker ('reply_marker') is a best guess that must be confirmed live — without it every reply is stored as a top-level comment on the focal post (still correct, just unlinked). Not validated against the live site in this repo.",
  "hosts": ["x.com", "twitter.com", "twimg.com"],
  "login": {"url": "https://x.com/i/flow/login", "cookie_url": "https://x.com", "cookies": ["auth_token"]},
  "search": {"keyword_url": "https://x.com/search?q={query}&f=live&src=typed_query", "use_keyword_search": true},
  "post_url": {
    "hosts": ["x.com", "twitter.com"],
    "path_patterns": ["^/(?:[A-Za-z0-9_]{1,15}|i(?:/web)?)/status(?:es)?/(?P<id>\\d{5,25})(?:/|$)"],
    "canonical": "https://x.com/i/status/{id}"
  },
  "handle_regex": "^/([A-Za-z0-9_]{1,15})/?$",
  "reserved_paths": ["i", "home", "explore", "search", "settings", "hashtag", "messages", "notifications", "compose", "login", "tos", "privacy"],
  "profile_url": "https://x.com/{handle}",
  "comment_id_regex": "/status/(\\d+)",
  "comment_url": "https://x.com/i/status/{id}",
  "visibility_evidence": "public X post page rendered (account not protected, post available)",
  "selectors": {
    "search_result_link": ["article[data-testid='tweet'] a[href*='/status/']:has(time)", "article[data-testid='tweet'] a[href*='/status/']", "a[href*='/status/']"],
    "post_region": ["article[data-testid='tweet'][tabindex='-1']", "main article[data-testid='tweet']"],
    "post_text": ["[data-testid='tweetText']"],
    "post_text_strip": [],
    "post_time": ["a[href*='/status/'] time[datetime]", "time[datetime]"],
    "post_author_link": ["[data-testid='User-Name'] a[href^='/']", "a[role='link'][href^='/']:not([href*='/status/'])"],
    "post_author_name": ["[data-testid='User-Name'] a[href^='/'] span", "[data-testid='User-Name'] span"],
    "like_count": ["[data-testid='like'] [data-testid='app-text-transition-container']", "[data-testid='like'] span", "[data-testid='unlike'] span"],
    "comment_count": ["[data-testid='reply'] span"],
    "org_marker": ["[data-testid='User-Name'] [aria-label*='verified organization' i]", "[data-testid='User-Name'] img[alt*='affiliat' i]"],
    "comment_list": ["section[aria-label*='Conversation' i]", "[aria-label*='Timeline: Conversation' i]"],
    "comment_item": ["article[data-testid='tweet']"],
    "comment_text": ["[data-testid='tweetText']"],
    "comment_text_strip": [],
    "comment_author_link": ["[data-testid='User-Name'] a[href^='/']"],
    "comment_author_name": ["[data-testid='User-Name'] a[href^='/'] span", "[data-testid='User-Name'] span"],
    "comment_time": ["a[href*='/status/'] time[datetime]", "time[datetime]"],
    "comment_permalink": ["a[href*='/status/']:has(time)"],
    "reply_marker": ["[data-testid='cellInnerDiv'][data-thread-reply='true']"],
    "expand_button": ["button", "[role='button']"],
    "comments_button": [],
    "comments_disabled": [],
    "challenge": ["iframe[src*='arkoselabs']", "iframe[src*='captcha']", "#arkose_iframe"]
  },
  "hide_selectors": ["[data-testid='User-Name']", "[data-testid='Tweet-User-Avatar']", "[data-testid^='UserAvatar-Container']", "[data-testid='UserCell']",
                     "article a[href^='/'][role='link']:not([href*='/status/'])"],
  "text_markers": {
    "expand": "^(show (more |additional )?replies|show more|view more replies)$",
    "login_prompt": ["sign in to x", "log in to x", "don’t miss what’s happening", "don't miss what's happening", "sign in to twitter"],
    "login_url": ["/i/flow/login", "/login"],
    "private": ["these posts are protected", "this account’s posts are protected", "this account's posts are protected", "these tweets are protected"],
    "unavailable": ["this post is unavailable", "hmm...this page doesn’t exist", "hmm...this page doesn't exist", "this post was deleted", "account suspended", "this account doesn’t exist", "this account doesn't exist"],
    "challenge": ["verify you are human", "authenticate your account", "solve this puzzle", "we need to make sure you're a real person"],
    "challenge_url": ["/account/access", "/account/login_challenge"]
  },
  "skip_reasons": {"private": "protected_account", "unavailable": "post_unavailable"},
  "limits": {
    "max_results_per_query": 10,
    "max_search_scrolls": 5,
    "max_comments_per_post": 200,
    "max_replies_per_comment": 50,
    "max_expansion_rounds": 15,
    "no_new_comment_attempts": 3,
    "comment_time_limit_s": 120,
    "scroll_pause_ms": 2000,
    "click_pause_ms": 900,
    "settle_ms": 4000
  }
}
